# Copy to .env. Every variable is optional: with no keys the app runs in demo mode
# (scripted planner + deterministic mock image/video providers).

# Claude planner. Without it, a scripted mock planner replays a canned conversation.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Runway image + image-to-video generation. Without it, mock providers are used.
RUNWAYML_API_SECRET=
RUNWAY_IMAGE_MODEL=gen4_image
RUNWAY_VIDEO_MODEL=gen4.5

# Agent loop limits.
AGENT_MAX_STEPS=8
AGENT_MAX_OUTPUT_TOKENS=8192
AGENT_CONTEXT_BUDGET_TOKENS=24000

PORT=8787
